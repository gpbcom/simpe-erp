# Copy to .env and fill in. Compose reads .env automatically.
#
# Every value here is a secret. .env must stay out of version control — the
# repository's .gitignore covers it, and adding one of these to app.yaml
# instead would publish it in the first commit that touches configuration.

# PostgreSQL password. Must match what the backend connects with.
POSTGRES_PASSWORD=rt_erp_dev

# Signs every access token. Anyone holding it can mint a token for any account,
# including an administrator's, so a deployment must set its own — 32+ random
# bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-in-any-real-deployment

# Object-store credentials. In the local stack these are also MinIO's root
# user and password.
S3_ACCESS_KEY=rt_erp_dev
S3_SECRET_KEY=rt_erp_dev_secret
