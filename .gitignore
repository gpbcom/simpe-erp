# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Local secrets. Never committed: the file holds the JWT signing key and the
# database and object-store passwords.
.env
.env.*
!.env.example

# Rotating application logs.
logs/

# The GUI campaign's output: output.xml, log.html, report.html and the raw V8
# coverage each suite writes. Regenerated by every run, and a log.html for a
# hundred tests is several megabytes.
qa/results/
.claude
