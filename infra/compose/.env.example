# Copy to .env, beside this file, and fill in.
#
# Compose reads .env from the *project directory*, which is the directory of the
# first `-f` file — this one. A .env left at the repository root is not read at
# all, and the stack comes up on the development defaults below without saying
# so.
#
# Every value here is a secret. .env must stay out of version control — the
# repository's .gitignore covers it, and adding one of these to app.yaml
# instead would publish it in the first commit that touches configuration.
#
# The development overlay falls back to the defaults shown below when a variable
# is unset. **The production overlay does not** — each one is declared there as
# `${VAR:?}`, so a stack launched without them refuses to start rather than
# coming up with a well-known signing key.

# PostgreSQL password. Must match what the backend connects with.
POSTGRES_PASSWORD=simple_erp_dev

# Signs every access token. Anyone holding it can mint a token for any account,
# including an administrator's, so a deployment must set its own — 32+ random
# bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-in-any-real-deployment

# Object-store credentials. In the local stack these are also MinIO's root
# user and password.
S3_ACCESS_KEY=simple_erp_dev
S3_SECRET_KEY=simple_erp_dev_secret

# Message-broker password. The broker carries the quote-validation events and
# the planning runs; it is also RabbitMQ's default user password in the stack.
RABBITMQ_PASSWORD=simple_erp_dev

# Outbound email. In development these reach Mailpit, which accepts any
# credentials and delivers nothing anywhere; in production they must belong to a
# real relay. EmailService authenticates unconditionally, so both must be set
# even when the server does not check them.
SMTP_USERNAME=dev
SMTP_PASSWORD=dev

# The shared secret the planning-completed webhook sends and checks. That
# endpoint is exempt from the bearer middleware — a webhook has no signed-in
# user to authenticate as — so this is the only thing standing between an
# anonymous caller and an operation that emails every assistant and customer.
PLANNING_WEBHOOK_TOKEN=change-me-too

# Where the browser reaches the API. Vite inlines it at **build** time, so in
# production it is a build argument and setting it on a running container does
# nothing. Development: the dev server talks cross-origin to the API directly.
# Read by `npm run dev` only. In a built image the API's address is no longer
# inlined: it is read at runtime from /config.json, which ships in the image
# naming the same-origin /api that nginx proxies, and which a deployment
# replaces with a mount or a ConfigMap. That is what makes one image promotable
# dev → staging → production instead of one image per environment.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Convenience, not configuration
# ---------------------------------------------------------------------------
# With this set, a developer who has `cd infra/compose` can type a bare
# `docker compose up` and get the development stack. CI keeps the explicit
# `-f infra/compose/... -f infra/compose/...` form, where being long is worth
# more than being short.
COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml
